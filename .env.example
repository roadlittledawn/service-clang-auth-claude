# Working local defaults. Copy to .env:  cp .env.example .env
# Nothing here is a production secret.

AUTH_BASE_URL=http://auth.localtest.me:4000
COOKIE_DOMAIN=.localtest.me
COOKIE_SECURE=false
ALLOW_INSECURE_ORIGINS=true
ALLOW_TOKEN_MINT=true

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=clang_auth

# sha256("dev-admin-key-change-me"). The CLI uses the raw key below.
ADMIN_API_KEY_HASH=29b401073038b82dd8106b36b0e4105cb0fcf084a083efccb6f525c8973bd2d2

# Leave SIGNING_KEY unset locally: a key is generated in .dev-keys/ on first run.
# SIGNING_KEY_PATH=.dev-keys/signing-key.pem
# SIGNING_KEYS_RETIRED=

SESSION_TTL=30d
SESSION_MAX_TTL=90d
ACCESS_TOKEN_TTL=15m
INVITE_TTL=72h
PORT=4000
LOG_LEVEL=info

# Used by the admin CLI (clang-auth), not by the service.
CLANG_AUTH_URL=http://auth.localtest.me:4000
CLANG_AUTH_ADMIN_KEY=dev-admin-key-change-me
